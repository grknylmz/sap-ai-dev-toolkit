# Canonical line endings: LF everywhere so Windows checkouts match the
# bundled agents/skills content the toolkit ships and parses.
* text=auto eol=lf
# Diff context lines are a space before tab-indented Go; that is content, not a whitespace error.
*.patch -whitespace
*.png binary
*.exe binary
*.icns binary
*.ico binary
*.tgz binary
*.zip binary

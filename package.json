{
  "name": "sap-ai-dev-toolkit",
  "version": "0.9.9926",
  "description": "SAP AI development toolkit for BAS, ABAP, RAP, CAP, HANA Cloud, Fiori, UI5, and MCP",
  "author": "Gurkan Yilmaz",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@abaplint/core": "2.119.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@sap/datasphere-cli": "2026.22.0",
    "@sap/hana-client": "2.30.27",
    "fflate": "0.8.3",
    "terminal-kit": "^3.1.4",
    "undici": "^6.21.3",
    "zod": "4.6.5"
  },
  "bin": {
    "sap-ai-dev": "src/launcher.mjs",
    "sap-ai-dev-toolkit": "src/launcher.mjs",
    "sap-ai-hana": "src/hana-inspector.mjs",
    "sap-ai-integration": "src/integration-server.mjs",
    "sap-ai-datasphere": "src/datasphere-server.mjs",
    "sap-ai-process-automation": "src/process-automation-server.mjs",
    "sap-ai-btp": "src/btp-server.mjs",
    "sap-ai-cloud-alm": "src/cloud-alm-server.mjs",
    "sap-ai-aem": "src/aem-server.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "install:local": "node scripts/install-local.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "datasphere": "node src/launcher.mjs --datasphere",
    "test:live:s4h": "node scripts/run-live-s4h.mjs",
    "test:live:integration": "node scripts/run-live-integration.mjs",
    "test:visibility": "node --test test/setup.test.mjs test/terminal-ui.test.mjs",
    "test:mutation": "node scripts/mutation-terminal-ui.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "prepublishOnly": "node scripts/build-vsp.mjs && node scripts/build-aem.mjs && node scripts/publish-npm.mjs --verify-only",
    "ensure:go": "node scripts/ensure-go.mjs",
    "build:vsp": "node scripts/build-vsp.mjs",
    "build:aem": "node scripts/build-aem.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grknylmz/sap-ai-dev-toolkit.git"
  },
  "homepage": "https://github.com/grknylmz/sap-ai-dev-toolkit#readme",
  "bugs": {
    "url": "https://github.com/grknylmz/sap-ai-dev-toolkit/issues"
  },
  "license": "MIT",
  "files": [
    "src/",
    "scripts/",
    "patches/",
    "dist/",
    "LICENSE",
    "NOTICE",
    "LICENSE-APACHE-2.0.txt",
    "tools.md",
    "inventory.md",
    ".github/agents/",
    ".github/skills/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  }
}

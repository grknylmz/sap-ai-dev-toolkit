+package adt
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestSilentNavigationTimeoutAsksForAPerson(t *testing.T) {
+	if err := navigationTimeout(true, time.Second); !errors.Is(err, ErrSSOInteractiveRequired) {
+		t.Fatalf("silent timeout = %v, want ErrSSOInteractiveRequired so a visible window opens", err)
+	}
+	if err := navigationTimeout(false, time.Second); errors.Is(err, ErrSSOInteractiveRequired) {
+		t.Fatalf("headed timeout = %v, must not ask for yet another window", err)
+	}
+}

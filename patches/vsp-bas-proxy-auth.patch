+package adt
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestSameHostLoginPageRefreshesSSO(t *testing.T) {
+	for _, method := range []string{http.MethodGet, http.MethodPost} {
+		for _, status := range []int{http.StatusOK, http.StatusUnauthorized, http.StatusForbidden} {
+			t.Run(method+"/"+http.StatusText(status), func(t *testing.T) {
+				refreshes := 0
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					cookie, err := r.Cookie("SAP_SESSIONID")
+					if err != nil || cookie.Value != "fresh" {
+						w.Header().Set("Content-Type", "text/html; charset=utf-8")
+						w.WriteHeader(status)
+						_, _ = io.WriteString(w, `<html><body><form action="/sap/saml2/sp/acs"><input name="SAMLRequest" value="fixture"></form></body></html>`)
+						return
+					}
+					w.Header().Set("X-CSRF-Token", "fresh-token")
+					w.Header().Set("Content-Type", "application/xml")
+					_, _ = io.WriteString(w, "<source>authenticated</source>")
+				}))
+				defer server.Close()
+				transport := NewTransportWithClient(&Config{
+					BaseURL: server.URL,
+					Cookies: map[string]string{"SAP_SESSIONID": "expired"},
+					ReauthFunc: func(context.Context) (map[string]string, error) {
+						refreshes++
+						return map[string]string{"SAP_SESSIONID": "fresh"}, nil
+					},
+				}, server.Client())
+				response, err := transport.Request(context.Background(), "/sap/bc/adt/source", &RequestOptions{Method: method})
+				if err != nil {
+					t.Fatalf("request failed: %v", err)
+				}
+				if refreshes != 1 || string(response.Body) != "<source>authenticated</source>" {
+					t.Fatalf("refreshes=%d body=%q, want one SSO refresh and authenticated source", refreshes, response.Body)
+				}
+			})
+		}
+	}
+}
+
+func TestOrdinaryForbiddenDoesNotRefreshSSO(t *testing.T) {
+	refreshes := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusForbidden)
+		_, _ = io.WriteString(w, "Missing development authorization")
+	}))
+	defer server.Close()
+	transport := NewTransportWithClient(&Config{BaseURL: server.URL, ReauthFunc: func(context.Context) (map[string]string, error) {
+		refreshes++
+		return nil, nil
+	}}, server.Client())
+	_, err := transport.Request(context.Background(), "/sap/bc/adt/source", &RequestOptions{Method: http.MethodGet})
+	if err == nil || refreshes != 0 {
+		t.Fatalf("err=%v refreshes=%d, want authorization error without SSO refresh", err, refreshes)
+	}
+}
+
+func TestSSOLoginPageAfterRefreshFailsWithoutLoop(t *testing.T) {
+	refreshes := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/sap/bc/adt/source" {
+			w.Header().Set("Content-Type", "text/html")
+			_, _ = io.WriteString(w, `<html><form><input type="password"></form></html>`)
+			return
+		}
+		w.Header().Set("X-CSRF-Token", "fresh-token")
+	}))
+	defer server.Close()
+	transport := NewTransportWithClient(&Config{BaseURL: server.URL, ReauthFunc: func(context.Context) (map[string]string, error) {
+		refreshes++
+		return map[string]string{"SAP_SESSIONID": "fresh"}, nil
+	}}, server.Client())
+	_, err := transport.Request(context.Background(), "/sap/bc/adt/source", &RequestOptions{Method: http.MethodGet})
+	if err == nil || !strings.Contains(err.Error(), "still unauthenticated") || refreshes != 1 {
+		t.Fatalf("err=%v refreshes=%d, want explicit failure after one refresh", err, refreshes)
+	}
+}

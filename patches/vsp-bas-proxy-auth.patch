+// navigationTimeout explains a first page that never finished loading. In a
+// silent browser that page is waiting on a person — a smart-card certificate
+// picker or a login prompt headless mode cannot show — so a visible window is
+// the next step, not a failed start.
+func navigationTimeout(headless bool, timeout time.Duration) error {
+	if headless {
+		return fmt.Errorf("%w: the silent sign-in page did not finish loading within %s", ErrSSOInteractiveRequired, timeout)
+	}
+	return fmt.Errorf("SSO capture timed out after %s", timeout)
+}
+
+// browserStartFailure ends a capture whose browser never came up; a silent one still escalates to a window.
+func browserStartFailure(headless bool, name, path string, err error) error {
+	detail := strings.Join(strings.Fields(err.Error()), " ")
+	if headless {
+		return fmt.Errorf("%w: %s did not start without a window (%s): %s", ErrSSOInteractiveRequired, name, path, detail)
+	}
+	return fmt.Errorf("%s could not be started from %s: %s", name, path, detail)
+}

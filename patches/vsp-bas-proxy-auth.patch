+// hasSession counts an unreadable cache as present so Cookies can report why.
+func (p *SSOProvider) hasSession() bool {
+	p.mu.Lock()
+	held := len(p.current) > 0
+	p.mu.Unlock()
+	if held {
+		return true
+	}
+	sess, err := LoadSSOSession(p.cachePath)
+	return err != nil || sess != nil
+}

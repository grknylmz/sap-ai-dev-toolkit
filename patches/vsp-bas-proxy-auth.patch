diff --git a/pkg/adt/ui5_list_filter_test.go b/pkg/adt/ui5_list_filter_test.go
new file mode 100644
index 0000000..1385d6d
--- /dev/null
+++ b/pkg/adt/ui5_list_filter_test.go
@@ -0,0 +1,59 @@
+package adt
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+// SAP's ADT filestore answers with every app whatever name and maxResults say.
+func TestUI5ListAppsFiltersWhatTheFilestoreIgnores(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/sap/bc/adt/filestore/ui5-bsp/objects" {
+			t.Errorf("unexpected request %s %s", r.Method, r.URL.Path)
+			http.NotFound(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "application/atom+xml")
+		_, _ = io.WriteString(w, `<atom:feed xmlns:atom="http://www.w3.org/2005/Atom">`+
+			`<atom:entry><atom:id>ZAPP_ONE</atom:id><atom:title>ZAPP_ONE</atom:title><atom:summary>One</atom:summary></atom:entry>`+
+			`<atom:entry><atom:id>/UI2/LAUNCHPAD</atom:id><atom:title>/UI2/LAUNCHPAD</atom:title></atom:entry>`+
+			`<atom:entry><atom:id>ZAPP_TWO</atom:id><atom:title>ZAPP_TWO</atom:title></atom:entry>`+
+			`</atom:feed>`)
+	}))
+	defer server.Close()
+	client := NewClient(server.URL, "user", "pass")
+
+	tests := []struct {
+		query      string
+		maxResults int
+		want       []string
+	}{
+		{"z*", 1, []string{"ZAPP_ONE"}},
+		{"Z*", 5, []string{"ZAPP_ONE", "ZAPP_TWO"}},
+		{"*LAUNCH*", 5, []string{"/UI2/LAUNCHPAD"}},
+		{"", 0, []string{"ZAPP_ONE", "/UI2/LAUNCHPAD", "ZAPP_TWO"}},
+	}
+	for _, tt := range tests {
+		apps, err := client.UI5ListApps(context.Background(), tt.query, tt.maxResults)
+		if err != nil {
+			t.Fatalf("UI5ListApps(%q, %d): %v", tt.query, tt.maxResults, err)
+		}
+		var got []string
+		for _, app := range apps {
+			got = append(got, app.Name)
+		}
+		if len(got) != len(tt.want) {
+			t.Errorf("UI5ListApps(%q, %d) = %v, want %v", tt.query, tt.maxResults, got, tt.want)
+			continue
+		}
+		for i := range got {
+			if got[i] != tt.want[i] {
+				t.Errorf("UI5ListApps(%q, %d) = %v, want %v", tt.query, tt.maxResults, got, tt.want)
+				break
+			}
+		}
+	}
+}

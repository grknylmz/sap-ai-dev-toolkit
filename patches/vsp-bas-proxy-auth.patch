+// navigationTimeout explains a first page that never finished loading. In a
+// silent browser that page is waiting on a person — a smart-card certificate
+// picker or a login prompt headless mode cannot show — so a visible window is
+// the next step, not a failed start.
+func navigationTimeout(headless bool, timeout time.Duration) error {
+	if headless {
+		return fmt.Errorf("%w: the silent sign-in page did not finish loading within %s", ErrSSOInteractiveRequired, timeout)

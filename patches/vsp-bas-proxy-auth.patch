+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+// Measured on S/4HANA 2023 (7.58): OPTIONS on a registered ADT resource answers
+// 400 "HTTP method OPTIONS not supported"; an unknown path answers 404.
+func TestFeatureProbesReadADTResourceAnswers(t *testing.T) {
+	tests := []struct {
+		name      string
+		feature   FeatureID
+		path      string
+		status    int
+		available bool
+		message   string
+	}{
+		{"RAP registered", FeatureRAP, "/sap/bc/adt/bo/behaviordefinitions", http.StatusBadRequest, true, "RAP endpoints available"},
+		{"RAP absent", FeatureRAP, "/sap/bc/adt/bo/behaviordefinitions", http.StatusNotFound, false, "RAP behavior definition endpoint not available"},
+		{"UI5 registered", FeatureUI5, "/sap/bc/adt/filestore/ui5-bsp/objects", http.StatusMethodNotAllowed, true, "UI5 BSP repository available (read-only through ADT)"},
+		{"UI5 absent", FeatureUI5, "/sap/bc/adt/filestore/ui5-bsp/objects", http.StatusNotFound, false, "UI5 BSP endpoint not available"},
+		{"CTS registered", FeatureTransport, "/sap/bc/adt/cts/transportrequests", http.StatusBadRequest, true, "CTS transport management available"},
+		{"CTS server error", FeatureTransport, "/sap/bc/adt/cts/transportrequests", http.StatusInternalServerError, false, "probe failed: ADT API error: status 500"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != http.MethodOptions || r.URL.Path != tt.path {
+					t.Errorf("unexpected request %s %s", r.Method, r.URL.Path)
+					http.NotFound(w, r)
+					return
+				}
+				w.WriteHeader(tt.status)
+				_, _ = io.WriteString(w, "HTTP&#x20;method&#x20;OPTIONS&#x20;not&#x20;supported")
+			}))
+			defer server.Close()
+
+			prober := NewFeatureProber(NewClient(server.URL, "user", "pass"), DefaultFeatureConfig(), false)
+			got := prober.Probe(context.Background(), tt.feature)
+			if got.Available != tt.available || !strings.HasPrefix(got.Message, tt.message) {
+				t.Errorf("Probe(%s) = available %v, message %q; want %v, %q", tt.feature, got.Available, got.Message, tt.available, tt.message)
+			}
+		})
+	}
+}

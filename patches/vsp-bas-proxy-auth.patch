diff --git a/pkg/adt/http_csrf_discovery_test.go b/pkg/adt/http_csrf_discovery_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/adt/http_csrf_discovery_test.go
@@ -0,0 +1,55 @@
+package adt
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestCSRFAlternateDiscoveryOnCoreFailure(t *testing.T) {
+	var requests []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests = append(requests, r.Method+" "+r.URL.Path)
+		switch r.URL.Path {
+		case "/sap/bc/adt/core/discovery":
+			w.WriteHeader(http.StatusInternalServerError)
+		case "/sap/bc/adt/discovery":
+			w.Header().Set("X-CSRF-Token", "valid-token")
+		case "/sap/bc/adt/datapreview/freestyle":
+			if r.Header.Get("X-CSRF-Token") != "valid-token" {
+				t.Errorf("POST missing fetched token")
+				w.WriteHeader(http.StatusForbidden)
+			}
+		default:
+			t.Errorf("unexpected request %s", r.URL.Path)
+		}
+	}))
+	defer srv.Close()
+	tr := newCSRFTestTransport(t, srv)
+	_, err := tr.Request(context.Background(), "/sap/bc/adt/datapreview/freestyle", &RequestOptions{Method: http.MethodPost, Body: []byte("SELECT * FROM T000")})
+	if err != nil {
+		t.Fatalf("read-only POST failed: %v", err)
+	}
+	want := []string{"HEAD /sap/bc/adt/core/discovery", "GET /sap/bc/adt/core/discovery", "HEAD /sap/bc/adt/discovery", "POST /sap/bc/adt/datapreview/freestyle"}
+	if strings.Join(requests, "|") != strings.Join(want, "|") {
+		t.Errorf("requests = %v, want %v", requests, want)
+	}
+}
+
+func TestCSRFAlternateDiscoveryFailureIncludesStatuses(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/sap/bc/adt/core/discovery" {
+			w.WriteHeader(http.StatusInternalServerError)
+		} else {
+			w.WriteHeader(http.StatusForbidden)
+		}
+	}))
+	defer srv.Close()
+	tr := newCSRFTestTransport(t, srv)
+	err := tr.fetchCSRFToken(context.Background())
+	if err == nil || !strings.Contains(err.Error(), "500") || !strings.Contains(err.Error(), "403") {
+		t.Fatalf("expected both endpoint failures, got %v", err)
+	}
+}

+package adt
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestBrowserThatCannotStartFailsFast(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("the stand-in browser is a shell script")
+	}
+	browser := filepath.Join(t.TempDir(), "blocked-browser")
+	if err := os.WriteFile(browser, []byte("#!/bin/sh\necho 'blocked by policy' >&2\nexit 3\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for _, headless := range []bool{true, false} {
+		started := time.Now()
+		_, err := CaptureSSOCookies(context.Background(), SSOOptions{
+			TriggerURL:  "https://sap.example/sap/bc/adt/",
+			BrowserPath: browser,
+			Headless:    headless,
+			Timeout:     45 * time.Second,
+		})
+		if elapsed := time.Since(started); elapsed > 15*time.Second {
+			t.Fatalf("headless=%v waited %v; a browser that never starts must not wait out the budget", headless, elapsed)
+		}
+		if err == nil || !strings.Contains(err.Error(), browser) || !strings.Contains(err.Error(), "blocked by policy") {
+			t.Fatalf("headless=%v err = %v, want the browser path and its output", headless, err)
+		}
+		// A silent start failure must still escalate to a visible window.
+		if errors.Is(err, ErrSSOInteractiveRequired) != headless {
+			t.Fatalf("headless=%v err = %v, want ErrSSOInteractiveRequired only when silent", headless, err)
+		}
+	}
+}

+
+func TestActivateMultipleObjectsSchemaIncludesItems(t *testing.T) {
+	cfg := &Config{
+		BaseURL:  "https://sap.example.com:44300",
+		Username: "testuser",
+		Password: "testpass",
+		Client:   "001",
+		Language: "EN",
+		Mode:     "expert",
+	}
+
+	server := NewServer(cfg)
+	if server == nil || server.mcpServer == nil {
+		t.Fatal("server or MCP server is nil")
+	}
+
+	rawResponse := server.mcpServer.HandleMessage(context.Background(), []byte(`{
+		"jsonrpc": "2.0",
+		"id": 1,
+		"method": "tools/list",
+		"params": {}
+	}`))
+	response, ok := rawResponse.(mcp.JSONRPCResponse)
+	if !ok {
+		t.Fatalf("expected JSONRPCResponse, got %T", rawResponse)
+	}
+
+	var tools []mcp.Tool
+	switch result := response.Result.(type) {
+	case mcp.ListToolsResult:
+		tools = result.Tools
+	case *mcp.ListToolsResult:
+		tools = result.Tools
+	default:
+		t.Fatalf("expected ListToolsResult, got %T", response.Result)
+	}
+
+	var activateMultipleTool *mcp.Tool
+	for i := range tools {
+		if tools[i].Name == "ActivateMultiple" {
+			activateMultipleTool = &tools[i]
+			break
+		}
+	}
+	if activateMultipleTool == nil {
+		t.Fatal("ActivateMultiple tool not found")
+	}
+
+	objectsRaw, ok := activateMultipleTool.InputSchema.Properties["objects"]
+	if !ok {
+		t.Fatal("objects property not found in ActivateMultiple schema")
+	}
+	objects, ok := objectsRaw.(map[string]interface{})
+	if !ok {
+		t.Fatalf("expected objects schema to be map[string]interface{}, got %T", objectsRaw)
+	}
+	if objects["type"] != "array" {
+		t.Fatalf("expected objects type to be 'array', got %v", objects["type"])
+	}
+
+	itemsRaw, ok := objects["items"]
+	if !ok {
+		t.Fatal("objects array schema is missing items")
+	}
+	items, ok := itemsRaw.(map[string]interface{})
+	if !ok {
+		t.Fatalf("expected objects.items to be map[string]interface{}, got %T", itemsRaw)
+	}
+	anyOf, ok := items["anyOf"].([]interface{})
+	if !ok || len(anyOf) != 2 {
+		t.Fatalf("expected objects.items.anyOf to contain string and object variants, got %v", items["anyOf"])
+	}
+	hasObject, hasString := false, false
+	for _, variant := range anyOf {
+		schema, ok := variant.(map[string]interface{})
+		if !ok {
+			t.Fatalf("expected item variant to be a schema object, got %T", variant)
+		}
+		switch schema["type"] {
+		case "object":
+			hasObject = true
+			properties, ok := schema["properties"].(map[string]interface{})
+			if !ok {
+				t.Fatal("object item schema is missing properties")
+			}
+			for _, propertyName := range []string{"url", "name"} {
+				propertyRaw, ok := properties[propertyName]
+				if !ok {
+					t.Fatalf("object item schema is missing %q", propertyName)
+				}
+				property, ok := propertyRaw.(map[string]interface{})
+				if !ok || property["type"] != "string" {
+					t.Fatalf("object item %q must have type string", propertyName)
+				}
+			}
+			required, ok := schema["required"].([]string)
+			if !ok || len(required) != 2 || required[0] != "url" || required[1] != "name" {
+				t.Fatalf("object item schema must require url and name, got %v", schema["required"])
+			}
+		case "string":
+			hasString = true
+		default:
+			t.Fatalf("unexpected ActivateMultiple item type %v", schema["type"])
+		}
+	}
+	if !hasObject || !hasString {
+		t.Fatalf("expected object and string item variants, got object=%t string=%t", hasObject, hasString)
+	}
+}

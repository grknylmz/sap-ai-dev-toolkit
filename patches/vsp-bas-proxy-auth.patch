+++ b/pkg/adt/client_components_test.go
@@ -0,0 +1,40 @@
+package adt
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestGetInstalledComponentsUsesADTFeed(t *testing.T) {
+	const accept = "application/atom+xml;type=feed"
+	const response = `<atom:feed xmlns:atom="http://www.w3.org/2005/Atom"><atom:entry><atom:id>SAP_BASIS</atom:id><atom:title>758;SAPK-75802INSAPBASIS;0002;SAP Basis &gt; 2022; patch</atom:title></atom:entry></atom:feed>`
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/sap/bc/adt/system/components" {
+			t.Errorf("unexpected request path: %s", r.URL.Path)
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		if got := r.Header.Get("Accept"); got != accept {
+			t.Errorf("Accept = %q, want %q", got, accept)
+			w.WriteHeader(http.StatusNotAcceptable)
+			return
+		}
+		w.Header().Set("Content-Type", accept)
+		_, _ = io.WriteString(w, response)
+	}))
+	defer server.Close()
+
+	components, err := NewClient(server.URL, "user", "pass").GetInstalledComponents(context.Background())
+	if err != nil {
+		t.Fatalf("GetInstalledComponents returned an error: %v", err)
+	}
+	if len(components) != 1 {
+		t.Fatalf("got %d components, want 1", len(components))
+	}
+	if got := components[0]; got.Name != "SAP_BASIS" || got.Release != "758" || got.SupportPack != "0002" || got.Description != "SAP Basis > 2022; patch" {
+		t.Errorf("got component %#v", got)
+	}
+}

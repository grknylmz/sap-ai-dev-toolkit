+func (p *SSOProvider) Start(ctx context.Context, windowFirst bool) (map[string]string, error) {
+	if windowFirst && !p.hasSession() {
+		fmt.Fprintf(os.Stderr, "[SSO] no cached session — opening a browser window to sign in\n")
+		return p.Login(ctx)
+	}
+	return p.Cookies(ctx)
+}

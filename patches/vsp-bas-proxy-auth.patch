+)
+
+func TestPublishServiceBindingUsesTheBindingProtocol(t *testing.T) {
+	tests := []struct {
+		name    string
+		status  int
+		version string
+		want    string
+	}{
+		{"V4 binding", http.StatusOK, "V4", "/sap/bc/adt/businessservices/odatav4/publishjobs"},
+		{"V2 binding", http.StatusOK, "V2", "/sap/bc/adt/businessservices/odatav2/publishjobs"},
+		{"unreadable binding", http.StatusNotFound, "", "/sap/bc/adt/businessservices/odatav2/publishjobs"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var published string
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch {
+				case strings.Contains(r.URL.Path, "/discovery"):
+					w.Header().Set("X-CSRF-Token", "TOKEN")
+				case r.Method == http.MethodGet && r.URL.Path == "/sap/bc/adt/businessservices/bindings/ZUI_DEMO":
+					w.WriteHeader(tt.status)
+					fmt.Fprintf(w, `<srvb:serviceBinding xmlns:srvb="http://www.sap.com/adt/ddic/ServiceBindings" xmlns:adtcore="http://www.sap.com/adt/core" adtcore:name="ZUI_DEMO"><srvb:binding srvb:type="ODATA" srvb:version="%s" srvb:category="0"/></srvb:serviceBinding>`, tt.version)
+				case r.Method == http.MethodPost && strings.HasSuffix(r.URL.Path, "/publishjobs"):
+					published = r.URL.Path
+					_, _ = io.WriteString(w, `<asx:abap xmlns:asx="http://www.sap.com/abapxml"><asx:values><DATA><SEVERITY>OK</SEVERITY><SHORT_TEXT>Published</SHORT_TEXT></DATA></asx:values></asx:abap>`)
+				default:
+					t.Errorf("unexpected request %s %s", r.Method, r.URL.Path)
+					http.NotFound(w, r)
+				}
+			}))
+			defer server.Close()
+
+			result, err := NewClient(server.URL, "user", "pass").PublishServiceBinding(context.Background(), "ZUI_DEMO", "0001")
+			if err != nil {
+				t.Fatalf("PublishServiceBinding: %v", err)
+			}
+			if published != tt.want || result.Severity != "OK" {
+				t.Errorf("published to %q with severity %q; want %q with OK", published, result.Severity, tt.want)
+			}
+		})
+	}
+}

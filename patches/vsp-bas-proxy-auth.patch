@@ -0,0 +1,52 @@
+package adt
+
+import (
+	"context"
+	"os"
+	"testing"
+)
+
+func TestStartWithWindowFirstReusesACachedSession(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	p, err := NewSSOProvider(SSOConfig{System: "devsys", BaseURL: "https://sap.example"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := SaveSSOSession(p.CachePath(), "sap.example", map[string]string{"SAP_SESSIONID_X": "live"}); err != nil {
+		t.Fatal(err)
+	}
+	// A browser launch here would fail the test on a build machine.
+	got, err := p.Start(context.Background(), true)
+	if err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	if got["SAP_SESSIONID_X"] != "live" {
+		t.Errorf("cookies = %v, want the cached session", got)
+	}
+}
+
+func TestHasSessionDecidesWhetherTheFirstSignInNeedsAWindow(t *testing.T) {
+	t.Setenv("HOME", t.TempDir())
+	p, err := NewSSOProvider(SSOConfig{System: "devsys", BaseURL: "https://sap.example"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.hasSession() {
+		t.Fatal("an empty cache must send the first sign-in to a window")
+	}
+	if err := SaveSSOSession(p.CachePath(), "sap.example", map[string]string{"SAP_SESSIONID_X": "live"}); err != nil {
+		t.Fatal(err)
+	}
+	if !p.hasSession() {
+		t.Fatal("a cached session must be reused, not replaced by a window")
+	}
+	if err := os.Remove(p.CachePath()); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(p.CachePath(), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if !p.hasSession() {
+		t.Fatal("an unreadable cache must reach Cookies, which reports the read error")
+	}
+}

+	detail := strings.Join(strings.Fields(err.Error()), " ")
+	if headless {
+		return fmt.Errorf("%w: %s did not start without a window (%s): %s", ErrSSOInteractiveRequired, name, path, detail)
+	}
+	return fmt.Errorf("%s could not be started from %s: %s", name, path, detail)

+
+// decodeClassNameSegment turns the class-name path segment of an object URL
+// ("%2FABC%2FCL_TEST") into the raw name ("/ABC/CL_TEST"). Downstream helpers
+// (GetClassIncludeSourceURL, GetClassMethods, activation) escape the name
+// themselves, so passing the still-encoded segment would yield "%252F".
+func decodeClassNameSegment(segment string) string {
+	if decoded, err := url.PathUnescape(segment); err == nil {
+		return decoded
+	}
+	return segment
+}
